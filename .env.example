# Copy to .env. Use only letters and numbers in the password: it goes inside
# a URL. .env is git-ignored.
POSTGRES_DB=ha_catalogue
POSTGRES_USER=ha
POSTGRES_PASSWORD=change-me
# 5433, not PostgreSQL's usual 5432, so it doesn't clash with a PostgreSQL
# already installed on your computer.
POSTGRES_PORT=5433
API_PORT=8000

# Which data `docker compose up` loads: data/sample (in git) or data/raw
# (the full catalogue, if you have it).
DATA_DIR=data/sample

# Used when you run Python on your own computer (load, API, migrations).
DATABASE_URL=postgresql+psycopg://ha:change-me@127.0.0.1:5433/ha_catalogue
